# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Exception: Allow Assimp library files for cross-platform builds
!Source/ThirdParty/Assimp/Lib/*.dylib
!Source/ThirdParty/Assimp/Lib/*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Exception: Allow Assimp static library files for Windows builds
!Source/ThirdParty/Assimp/Lib/*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Exception: Allow prerequisites setup executable for Windows builds
!prereq/UEPrereqSetup_x64.exe

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Don't ignore Mac platform template files for network permissions
!Build/Mac/Resources/Info.Template.plist
!Build/Mac/Resources/Sandbox.Network.entitlements

# Allow all the paths that lead to the application catalog
!Build/Mac
!Build/Mac/Resources
!Build/Mac/Resources/Assets.xcassets
!Build/Mac/Resources/Assets.xcassets/**

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

#################################
# Unreal Engine Generated Files #
#################################
/[Bb]uilds
/Binaries
/DerivedDataCache
/Intermediate
/Saved

#################################
# Visual Studio Generated Files #
#################################
# Cache Directory
.vs
# User Specific Files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
# CPP Cache Files
*.VC.db
*.opendb
*.opensdf
*.sdf
# Solution Files
*.sln
# VSCode Cache Directory
.vscode
# VSCode History Files
**/.history

.idea
**/.DS_Store

Plugins/TurboSequence-UE_5.4_fix1

Plugins/Developer/

/output/*

# Build number file - auto-incremented by build scripts
scripts/build_number.txt
vcpkg
